  id                      String        @id @default(uuid())

  debtorAccountId          String

  contractNumber           String?
  contractName             String

  startDate                DateTime
  endDate                  DateTime?

  billingCycle             BillingCycle @default(MONTHLY)
  paymentTermsDays         Int          @default(30)

  creditLimit              Decimal?     @db.Decimal(14,2)

  requiresPreAuthorization Boolean      @default(false)

  outpatientAllowed        Boolean      @default(true)
  inpatientAllowed         Boolean      @default(true)
  pharmacyAllowed          Boolean      @default(true)
  laboratoryAllowed        Boolean      @default(true)
  radiologyAllowed         Boolean      @default(true)

  isActive                 Boolean      @default(true)

  notes                    String?

  createdById              String?
  updatedById              String?

  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  debtorAccount            DebtorAccount @relation(fields: [debtorAccountId], references: [id])

  @@index([debtorAccountId])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model DebtorStatement {
  id                  String          @id @default(uuid())

  statementNumber     String          @unique

  debtorAccountId     String

  periodStart         DateTime
  periodEnd           DateTime

  openingBalance      Decimal         @default(0) @db.Decimal(14,2)
  invoiceTotal        Decimal         @default(0) @db.Decimal(14,2)
  paymentTotal        Decimal         @default(0) @db.Decimal(14,2)
  adjustmentTotal     Decimal         @default(0) @db.Decimal(14,2)
  closingBalance      Decimal         @default(0) @db.Decimal(14,2)

  status              StatementStatus @default(GENERATED)

  generatedById       String?
  generatedAt         DateTime        @default(now())

  sentById            String?
  sentAt              DateTime?

  acknowledgedAt      DateTime?
  disputedAt          DateTime?
  disputeReason       String?

  fileUrl             String?

  debtorAccount       DebtorAccount   @relation(fields: [debtorAccountId], references: [id])

  @@index([debtorAccountId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

model DebtorReconciliation {
  id                    String                @id @default(uuid())

  reconciliationNumber  String                @unique

  debtorAccountId       String

  statementId           String?

  paymentReference      String?
  remittanceReference   String?

  remittanceAmount      Decimal?              @db.Decimal(14,2)
  matchedAmount         Decimal               @default(0) @db.Decimal(14,2)
  unmatchedAmount       Decimal               @default(0) @db.Decimal(14,2)

  status                ReconciliationStatus  @default(OPEN)

  notes                 String?

  startedById           String?
  startedAt             DateTime              @default(now())

  closedById            String?
  closedAt              DateTime?

  debtorAccount         DebtorAccount         @relation(fields: [debtorAccountId], references: [id])

  @@index([debtorAccountId])
  @@index([status])
}

model DebtorDocument {
  id              String             @id @default(uuid())

  debtorAccountId String

  documentType    DebtorDocumentType

  fileName        String
  fileUrl         String
  mimeType        String?
  fileSize        Int?

  notes           String?

  uploadedById    String?
  uploadedAt      DateTime           @default(now())

  debtorAccount   DebtorAccount      @relation(fields: [debtorAccountId], references: [id])

  @@index([debtorAccountId])
  @@index([documentType])
}

model DebtorAuditLog {
  id              String            @id @default(uuid())

  debtorAccountId String?

  actorId         String?

  action          DebtorAuditAction

  entityType      String
  entityId        String

  previousValues  Json?
  newValues       Json?

  reason          String?

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime          @default(now())

  debtorAccount   DebtorAccount?    @relation(fields: [debtorAccountId], references: [id])

  @@index([debtorAccountId])
  @@index([actorId])
  @@index([action])
}

// ============================================================================
// SCHEME OPERATIONS MODELS
// ============================================================================

model SchemeDepartmentRule {
  id                    String   @id @default(uuid())
  debtorAccountId       String
  departmentId          String?
  servicePointId        String?
  isAllowed             Boolean  @default(true)
  requiresAuthorization Boolean  @default(false)
  allowsCashTopup       Boolean  @default(true)
  visitLimitAmount      Decimal? @db.Decimal(14,2)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  debtorAccount         DebtorAccount @relation(fields: [debtorAccountId], references: [id], onDelete: Cascade)

  @@index([debtorAccountId])
  @@index([departmentId])
  @@index([isActive])
}

model SchemeOutpatientLimit {
  id                    String   @id @default(uuid())
  debtorAccountId       String
  departmentId          String?
  servicePointId        String?
  limitType             String
  limitAmount           Decimal  @db.Decimal(14,2)
  periodType            String
  requiresAuthorization Boolean  @default(false)
  allowsCashTopup       Boolean  @default(true)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  debtorAccount         DebtorAccount @relation(fields: [debtorAccountId], references: [id], onDelete: Cascade)

  @@index([debtorAccountId])
  @@index([departmentId])
  @@index([limitType])
  @@index([isActive])
}

model SchemeVisitLimit {
  id                    String   @id @default(uuid())
  debtorAccountId       String
  departmentId          String?
  visitType             String?
  visitLimitAmount      Decimal  @db.Decimal(14,2)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  debtorAccount         DebtorAccount @relation(fields: [debtorAccountId], references: [id], onDelete: Cascade)

  @@index([debtorAccountId])
  @@index([departmentId])
  @@index([isActive])
}

model SchemeCopaymentRule {
  id                    String   @id @default(uuid())
  debtorAccountId       String
  departmentId          String?
  servicePointId        String?
  category              String?
  copaymentType         String
  percentageValue       Decimal? @db.Decimal(5,2)
  fixedAmount           Decimal? @db.Decimal(14,2)
  minimumAmount         Decimal? @db.Decimal(14,2)
  maximumAmount         Decimal? @db.Decimal(14,2)
  appliesToConsultation Boolean  @default(false)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  debtorAccount         DebtorAccount @relation(fields: [debtorAccountId], references: [id], onDelete: Cascade)

  @@index([debtorAccountId])
  @@index([departmentId])
  @@index([category])
  @@index([isActive])
}
