// ==================== PHARMACY MODULE ====================

enum StockMovementType {
  PURCHASE_RECEIPT
  DISPENSE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRY_WRITEOFF
  RETURN_IN
  RETURN_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum StockAdjustmentReason {
  DAMAGED
  EXPIRED
  LOST
  COUNT_ERROR
  PRICE_ADJUSTMENT
  QUALITY_ISSUE
  OTHER
}

model DrugCategory {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  name        String
  code        String
  description String?
  parentId    String?    @db.Uuid
  isActive    Boolean    @default(true)
  createdById String?    @db.Uuid
  updatedById String?    @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      DrugCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    DrugCategory[] @relation("CategoryHierarchy")
  drugs       Drug[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
}

model Drug {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  categoryId        String?     @db.Uuid
  name              String
  genericName       String?
  brandName         String?
  drugCode          String
  barcode           String?
  dosageForm        String?     // Tablet, Capsule, Syrup, Injection, etc.
  strength          String?     // 500mg, 250mg/5ml, etc.
  unitOfMeasure     String      // Tablet, Bottle, Box, Strip, etc.
  packSize          Int?        // Number of units per pack
  manufacturer      String?
  requiresPrescription Boolean  @default(false)
  isControlledSubstance Boolean @default(false)
  storageConditions String?     // Room temperature, Refrigerate, etc.
  shelfLife         Int?        // Shelf life in months
  reorderLevel      Int         @default(10)
  maxStockLevel     Int?
  standardPrice     Decimal     @default(0) @db.Decimal(14, 2)
  sellingPrice      Decimal     @default(0) @db.Decimal(14, 2)
  taxRate           Decimal     @default(0) @db.Decimal(5, 2)
  isActive          Boolean     @default(true)
  notes             String?
  createdById       String?     @db.Uuid
  updatedById       String?     @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          DrugCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches           DrugBatch[]
  prescriptionItems PrescriptionItem[]
  dispenseItems     DispenseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[] @relation("DrugStockAdjustments")
  stockAdjustmentItems StockAdjustmentItem[]
  transferItems     StockTransferItem[]
  saleItems         SaleItem[]
  supplierReturnItems SupplierReturnItem[]
  grnItems          GoodsReceivedNoteItem[]

  @@unique([tenantId, drugCode])
  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
}

model DrugBatch {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  drugId          String   @db.Uuid
  batchNumber     String
  supplierId      String?  @db.Uuid
  storeId         String?  @db.Uuid
  manufactureDate DateTime?
  expiryDate      DateTime
  quantityReceived Int     @default(0)
  quantityDispensed Int    @default(0)
  quantitySold    Int      @default(0)
  quantityAdjusted Int     @default(0)
  quantityTransferredOut Int @default(0)
  quantityTransferredIn Int @default(0)
  quantityReturned Int     @default(0)
  quantityExpired Int       @default(0)
  currentStock    Int
  costPrice       Decimal  @db.Decimal(14, 2)
  sellingPrice    Decimal  @db.Decimal(14, 2)
  isLocked        Boolean  @default(false)
  notes           String?
  createdById     String?  @db.Uuid
  updatedById     String?  @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drug            Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  store           PharmacyStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  stockMovements  StockMovement[]
  dispenseItems   DispenseItem[]
  saleItems       SaleItem[]
  grnItems        GoodsReceivedNoteItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  supplierReturnItems SupplierReturnItem[]

  @@unique([tenantId, drugId, batchNumber])
  @@index([tenantId, drugId])
  @@index([expiryDate])
  @@index([storeId])
}

model PharmacyStore {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  name        String
  code        String
  description String?
  storeType   String   @default("MAIN") // MAIN, SATELLITE, WARD, DISPENSARY
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batches     DrugBatch[]
  stockMovements StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferSource")
  transfersTo   StockTransfer[] @relation("TransferDestination")
  adjustments StockAdjustment[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  branchId        String            @db.Uuid
  storeId         String?           @db.Uuid
  drugId          String            @db.Uuid
  batchId         String            @db.Uuid
  movementType    StockMovementType
  quantity        Int
