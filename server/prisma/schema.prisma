generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BillingType {
  CASH
  CREDIT
  INSURANCE
}

enum PayerType {
  CASH
  INSURANCE
  CORPORATE
  PATIENT_CREDIT
  SHA
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
  REJECTED
}

enum PrescriptionItemStatus {
  PENDING
  APPROVED
  DISPENSED
  PARTIALLY_DISPENSED
  UNAVAILABLE
  SUBSTITUTED
  REJECTED
}

enum PharmacySaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CREDIT_APPROVED
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
  REFUNDED
}

enum PharmacyPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  CREDIT_BILLED
  CANCELLED
}

enum PharmacyReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum PharmacyAuditAction {
  ITEM_CREATED
  ITEM_UPDATED
  PRICE_UPDATED
  STOCK_RECEIVED
  STOCK_ADJUSTED
  STOCK_DISPENSED
  PRESCRIPTION_CREATED
  PRESCRIPTION_APPROVED
  SALE_CREATED
  SALE_PAID
  SALE_CREDIT_BILLED
  SALE_DISPENSED
  RETURN_CREATED
  RETURN_APPROVED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED_TO_PAYER
  PARTIALLY_PAID
  FULLY_PAID
  REJECTED
  CANCELLED
  REVERSED
}

enum PatientStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNKNOWN
}

enum PayerType {
  CASH
  INSURANCE
  CORPORATE
  SHA
  PATIENT_CREDIT
}

enum VisitType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  DAYCARE
  WALKIN
  REFERRAL
  REVIEW
  FOLLOW_UP
}

enum VisitStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PatientDocumentType {
  NATIONAL_ID
  PASSPORT
  BIRTH_CERTIFICATE
  DRIVING_LICENSE
  OTHER
}

enum PatientAlertType {
  ALLERGY
  FALL_RISK
  VIP
  SECURITY
  PAYMENT_REQUIRED
  CLINICAL_WARNING
  OTHER
}

enum PatientAuditAction {
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_STATUS_CHANGED
  VISIT_CREATED
  VISIT_UPDATED
  VISIT_CANCELLED
  DOCUMENT_UPLOADED
  ALERT_CREATED
  ALERT_RESOLVED
}

enum VisitType {
  OUTPATIENT
  INPATIENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
  CARD
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  SETTLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  REVERSED
  SUBMITTED_TO_PAYER
  CLAIM_GENERATED
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  code               String              @unique
  legalName          String?
  registrationNo     String?
  taxPin             String?
  phone              String?
  email              String?
  website            String?
  contactPersonName  String?
  contactPersonPhone String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  timezone           String?
  isActive           Boolean             @default(true)
  createdById        String?             @db.Uuid
  updatedById        String?             @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branches           Branch[]
  users              User[]
  roles              Role[]
  permissions        Permission[]
  userRoles          UserRole[]
  rolePermissions    RolePermission[]
  userBranches       UserBranch[]
  departments        Department[]
  userDepartments    UserDepartment[]
  patients           Patient[]
  visits             Visit[]
  creditCustomers    CreditCustomer[]
  insuranceSchemes   InsuranceScheme[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  invoiceApprovals   InvoiceApproval[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  receipts           Receipt[]
  claims             Claim[]
  auditLogs          AuditLog[]
  // Pharmacy module relations
  drugCategories     DrugCategory[]
  drugs              Drug[]
  drugBatches        DrugBatch[]
  pharmacyStores     PharmacyStore[]
  stockMovements     StockMovement[]
  prescriptions      Prescription[]
  prescriptionItems  PrescriptionItem[]
  dispenses          Dispense[]
  dispenseItems      DispenseItem[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]
  goodsReceivedNoteItems GoodsReceivedNoteItem[]
  stockTransfers     StockTransfer[]
  stockTransferItems StockTransferItem[]
  stockAdjustments   StockAdjustment[]
  stockAdjustmentItems StockAdjustmentItem[]
  sales              Sale[]
  saleItems          SaleItem[]
  pharmacySales      PharmacySale[]
  pharmacySaleItems  PharmacySaleItem[]
  pharmacyReturns    PharmacyReturn[]
  supplierReturns    SupplierReturn[]
  supplierReturnItems SupplierReturnItem[]
  // Cash management module relations
  cashCounters       CashCounter[]
  cashierProfiles    CashierProfile[]
  cashSessions       CashSession[]
  cashPayments       CashPayment[]
  cashRefunds        CashRefund[]
  cashHandovers      CashHandover[]
}

model Branch {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  name               String
  code               String
  branchType         String?
  phone              String?
  email              String?
  contactPersonName  String?
  contactPersonPhone String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  isActive           Boolean             @default(true)
  createdById        String?             @db.Uuid
  updatedById        String?             @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches       UserBranch[]
  departments        Department[]
  userDepartments    UserDepartment[]
  patients           Patient[]
  visits             Visit[]
  creditCustomers    CreditCustomer[]
  insuranceSchemes   InsuranceScheme[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  invoiceApprovals   InvoiceApproval[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  receipts           Receipt[]
  claims             Claim[]
  auditLogs          AuditLog[]
  // Pharmacy module relations
  pharmacyStores     PharmacyStore[]
  stockMovements     StockMovement[]
  prescriptions      Prescription[]
  dispenses          Dispense[]
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  stockAdjustments   StockAdjustment[]
  sales              Sale[]
  supplierReturns    SupplierReturn[]
  transfersFrom      StockTransfer[]   @relation("TransferFromBranch")
  transfersTo        StockTransfer[]   @relation("TransferToBranch")
  // Cash management module relations
  cashCounters       CashCounter[]
  cashierProfiles    CashierProfile[]
  cashSessions       CashSession[]
  cashPayments       CashPayment[]
  cashRefunds        CashRefund[]
  cashHandovers      CashHandover[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String?     @db.Uuid
  firstName        String
  middleName       String?
  lastName         String
  email            String      @unique
  phone            String?
  staffId          String?
  jobTitle         String?
  gender           String?
  dateOfBirth      DateTime?
  address          String?
  primaryDepartmentId String?  @db.Uuid
  passwordHash     String
  isSuperAdmin     Boolean     @default(false)
  isActive         Boolean     @default(true)
  refreshTokenHash String?
  createdById      String?     @db.Uuid
  updatedById      String?     @db.Uuid
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  primaryDepartment Department? @relation("PrimaryDepartment", fields: [primaryDepartmentId], references: [id], onDelete: SetNull)
  roles            UserRole[]
  branches         UserBranch[]
  departments      UserDepartment[]
  auditLogs        AuditLog[]
  cashierProfile   CashierProfile?

  @@unique([tenantId, staffId])
  @@index([tenantId])
}

model Department {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  branchId        String?          @db.Uuid
  name            String
  code            String
  description     String?
  isClinical      Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdById     String?          @db.Uuid
  updatedById     String?          @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  usersPrimary    User[]           @relation("PrimaryDepartment")
  userDepartments UserDepartment[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
}

model Role {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String?          @db.Uuid
  name             String
  code             String           @unique
  description      String?
  isSystem         Boolean          @default(false)
  createdById      String?          @db.Uuid
  updatedById      String?          @db.Uuid
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@index([tenantId])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @db.Uuid
  name            String
  code            String           @unique
  description     String?
  createdById     String?          @db.Uuid
  updatedById     String?          @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]

  @@index([tenantId])
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, userId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String?    @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdById  String?    @db.Uuid
  updatedById  String?    @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
}

model UserBranch {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  branchId    String   @db.Uuid
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, userId])
}

model UserDepartment {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  branchId     String?     @db.Uuid
  userId       String      @db.Uuid
  departmentId String      @db.Uuid
  createdById  String?     @db.Uuid
  updatedById  String?     @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, departmentId])
  @@index([tenantId, userId, departmentId])
}

model Patient {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  branchId           String             @db.Uuid
  
  // Primary identifiers
  hospitalNumber     String             @unique @map("uhid")
  firstName          String
  middleName         String?
  lastName           String
  
  // Demographics
  gender             Gender             @default(UNKNOWN)
  dateOfBirth        DateTime?
  maritalStatus      MaritalStatus      @default(UNKNOWN)
  
  // National IDs
  nationalId         String?
  passportNumber     String?
  
  // Contact information
  phone              String?
  alternativePhone   String?
  email              String?
  
  // Address
  address            String?
  county             String?
  city               String?
  
  // Status
  status             PatientStatus      @default(ACTIVE)
  
  // Audit fields
  createdById        String?            @db.Uuid
  updatedById        String?            @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  // Relations
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  contacts           PatientContact[]
  visits             PatientVisit[]
  payerProfiles      PatientPayerProfile[]
  documents          PatientDocument[]
  alerts             PatientAlert[]
  auditLogs          PatientAuditLog[]
  invoices           Invoice[]
  payments           Payment[]
  receipts           Receipt[]
  claims             Claim[]
  prescriptions      Prescription[]

  @@unique([tenantId, hospitalNumber])
  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([nationalId])
  @@index([tenantId, branchId])
}

model PatientVisit {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  branchId           String        @db.Uuid
  patientId          String        @db.Uuid
  
  visitNumber        String        @unique @map("visitNo")
  visitType          VisitType     @default(OUTPATIENT)
  status             VisitStatus   @default(OPEN)
  
  payerType          PayerType     @default(CASH)
  payerProfileId     String?
  
  departmentName     String?
  clinicName         String?
  attendingDoctorId  String?
  
  checkInAt          DateTime      @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  
  notes              String?
  
  createdById        String?       @db.Uuid
  updatedById        String?       @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoices           Invoice[]
  claims             Claim[]
  prescriptions      Prescription[]

  @@unique([tenantId, visitNumber])
  @@index([patientId])
  @@index([status])
  @@index([tenantId, branchId, patientId])
}

// Legacy Visit model alias for backward compatibility
model Visit {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  branchId           String    @db.Uuid
  patientId          String    @db.Uuid
  visitNo            String
  visitDate          DateTime
  visitType          VisitType @default(OUTPATIENT)
  doctorName         String?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoices           Invoice[]
  claims             Claim[]
  prescriptions      Prescription[]

  @@unique([tenantId, visitNo])
  @@index([tenantId, branchId, patientId])
}

model PatientContact {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  branchId       String   @db.Uuid
  
  patientId      String   @db.Uuid
  
  fullName       String
  relationship   String
  phone          String
  email          String?
  address        String?
  
  isEmergency    Boolean  @default(false)
  isPrimary      Boolean  @default(false)
  
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([tenantId, branchId])
}

model PatientPayerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  branchId           String    @db.Uuid
  
  patientId          String    @db.Uuid
  
  payerType          PayerType
  
  insuranceProvider  String?
  policyNumber       String?
  memberNumber       String?
  
  corporateAccountId String?
  creditAccountId    String?
  
  isDefault          Boolean   @default(false)
  isActive           Boolean   @default(true)
  
  notes              String?
  
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([payerType])
  @@index([tenantId, branchId])
}

model PatientDocument {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  branchId        String              @db.Uuid
  
  patientId       String              @db.Uuid
  
  documentType    PatientDocumentType
  
  fileName        String
  fileUrl         String
  mimeType        String?
  fileSize        Int?
  
  notes           String?
  
  uploadedById    String?           @db.Uuid
  uploadedAt      DateTime            @default(now())
  deletedAt       DateTime?
  
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([tenantId, branchId])
}

model PatientAlert {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  branchId       String           @db.Uuid
  
  patientId      String           @db.Uuid
  
  alertType      PatientAlertType
  
  title          String
  description    String?
  
  isActive       Boolean          @default(true)
  
  createdById    String?          @db.Uuid
  resolvedById   String?          @db.Uuid
  resolvedAt     DateTime?
  deletedAt      DateTime?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([isActive])
  @@index([tenantId, branchId])
}

model PatientAuditLog {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  branchId       String             @db.Uuid
  
  patientId      String?            @db.Uuid
  actorId        String?            @db.Uuid
  
  action         PatientAuditAction
  
  entityType     String
  entityId       String
  
  previousValues Json?
  newValues      Json?
  
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime           @default(now())
  
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient?           @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([actorId])
  @@index([action])
  @@index([tenantId, branchId])
}

model CreditCustomer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  branchId           String?   @db.Uuid
  name               String
  customerCode       String
  customerType       String
  creditLimit        Decimal   @default(0) @db.Decimal(14, 2)
  isActive           Boolean   @default(true)
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  claims             Claim[]

  @@unique([tenantId, customerCode])
  @@index([tenantId, branchId])
}

model InsuranceScheme {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  branchId              String?   @db.Uuid
  name                  String
  schemeCode            String
  requiresAuthorization Boolean   @default(false)
  createdById           String?   @db.Uuid
  updatedById           String?   @db.Uuid
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoices              Invoice[]
  claims                Claim[]
  dispenses             Dispense[]

  @@unique([tenantId, schemeCode])
  @@index([tenantId, branchId])
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  branchId          String        @db.Uuid
  invoiceNo         String
  invoiceDate       DateTime
  patientId         String        @db.Uuid
  visitId           String        @db.Uuid
  creditCustomerId  String?       @db.Uuid
  schemeId          String?       @db.Uuid
  billingType       BillingType
  authorizationNo   String?
