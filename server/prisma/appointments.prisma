// Appointment Management Enums

enum AppointmentStatus {
  DRAFT
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  NEW_CONSULTATION
  FOLLOW_UP
  SPECIALIST_CONSULTATION
  PROCEDURE
  REVIEW
  ANTENATAL
  DENTAL
  EYE
  PHYSIOTHERAPY
  COUNSELLING
  OTHER
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum AppointmentSource {
  WALK_IN
  PHONE
  FRONT_DESK
  DOCTOR_REQUEST
  FOLLOW_UP
  REFERRAL
  ONLINE
}

enum AppointmentAuditAction {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_MARKED_NO_SHOW
  APPOINTMENT_COMPLETED
  SLOT_CREATED
  SLOT_UPDATED
  SLOT_BLOCKED
}

// Appointment Schedule Template Model
model AppointmentScheduleTemplate {
  id              String   @id @default(uuid())

  name            String

  departmentId    String?
  clinicId        String?
  doctorId        String?

  dayOfWeek       Int      // 0 Sunday, 1 Monday, etc.

  startTime       String   // HH:mm
  endTime         String   // HH:mm

  slotMinutes     Int      @default(30)
  capacityPerSlot Int      @default(1)

  isActive        Boolean  @default(true)

  createdById     String?
  updatedById     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId])
  @@index([doctorId])
  @@index([dayOfWeek])
  @@index([isActive])
}

// Appointment Slot Model
model AppointmentSlot {
  id                  String   @id @default(uuid())

  departmentId        String?
  clinicId            String?
  doctorId            String?
  serviceUnitId       String?

  startAt             DateTime
  endAt               DateTime

  capacity            Int      @default(1)
  bookedCount         Int      @default(0)

  isBlocked           Boolean  @default(false)
  blockReason         String?

  createdById         String?
  updatedById         String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([departmentId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([startAt])
  @@index([isBlocked])
}

// Appointment Model
model Appointment {
  id                  String              @id @default(uuid())

  appointmentNumber   String              @unique

  patientId           String

  patientVisitId      String?
  clinicVisitId       String?
  queueEntryId        String?
  emrEncounterId      String?

  departmentId        String?
  clinicId            String?
  serviceUnitId       String?
  doctorId            String?

  appointmentType     AppointmentType
  priority            AppointmentPriority @default(ROUTINE)
  source              AppointmentSource   @default(FRONT_DESK)

  status              AppointmentStatus   @default(BOOKED)

  scheduledStartAt    DateTime
  scheduledEndAt      DateTime

  reason              String?
  notes               String?

  confirmedAt         DateTime?
  confirmedById       String?

  checkedInAt         DateTime?
  checkedInById       String?

  completedAt         DateTime?
  completedById       String?

  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?

  noShowAt            DateTime?
  noShowById          String?

  rescheduledFromId   String?
  rescheduledToId     String?
  rescheduledAt       DateTime?
  rescheduledById     String?
  rescheduleReason    String?

  createdById         String?
  updatedById         String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  auditLogs           AppointmentAuditLog[]

  @@index([patientId])
  @@index([departmentId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledStartAt])
}

// Appointment Audit Log Model
model AppointmentAuditLog {
  id              String                 @id @default(uuid())

  appointmentId   String?

  actorId         String?

  action          AppointmentAuditAction

  entityType      String
  entityId        String

  previousValues  Json?
  newValues       Json?

  reason          String?

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime               @default(now())

  appointment     Appointment?           @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([actorId])
  @@index([action])
}
